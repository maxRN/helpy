# Copy to .env (never commit .env). Read with process.env in server routes only.
# Never prefix these with VITE_, or they ship to the browser.
ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to a workspace (Console → Settings → Workspaces → the workspace id, starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# Model for /api/policy (P2)
POLICY_MODEL=claude-sonnet-5-5

# ElevenLabs (P2)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_INTERVIEWER=
ELEVENLABS_AGENT_TUTOR=
ELEVENLABS_TTS_VOICE_ID=
# optional
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
