# Copy to .env (never commit .env). Read with process.env in server routes only.
# Never prefix these with VITE_, or they ship to the browser.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

# Public Convex URL. npm run dev:convex writes the selected URL to .env.local.
VITE_CONVEX_URL=
